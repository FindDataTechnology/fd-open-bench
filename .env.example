# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fd_open_bench

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
DEBUG=true

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Authentication Configuration
SECRET_KEY=your-super-secret-key-change-in-production
JWT_EXPIRE_HOURS=24

# LLM API Keys (configure your preferred provider)
OPENAI_API_KEY=your-openai-api-key-here
# or
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# or
AZURE_OPENAI_API_KEY=your-azure-api-key-here
# AZURE_OPENAI_API_BASE = https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION = 2023-05-15

# DeepEval Configuration
DEEPEVAL_PLATFORM_URL=https://evals.confident.ai
DEEPEVAL_PROJECT_ID=your-project-id
DEEPEVAL_TEST_CASES_UPLOAD_BATCH_SIZE=25

# Optional: External API endpoints for notifications
WEBHOOK_URL=https://your-webhook-url.com
EMAIL_SMTP_SERVER=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-email@example.com
EMAIL_SMTP_PASSWORD=your-email-password

# Cost Configuration (per task business value in dollars)
DEFAULT_BUSINESS_VALUE_PER_TASK=100.00

# Data Retention (in days)
TRACE_RETENTION_DAYS=90
RESULT_RETENTION_DAYS=365
RUN_RETENTION_DAYS=730

# Security Headers (optional, for production)
SECURE_COOKIES=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
